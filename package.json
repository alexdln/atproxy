{
    "name": "atproxy",
    "description": "Privacy-first browser extension and local proxy server that gives you complete control over XRPC requests from atproto applications",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "build": "pnpm -r build",
        "dev:proxy": "pnpm --filter atproxy dev",
        "dev:extension": "pnpm --filter extension dev",
        "build:proxy": "pnpm --filter atproxy build",
        "start:proxy": "pnpm --filter atproxy start",
        "build:extension": "pnpm --filter extension build",
        "lint": "eslint .",
        "eslint": "eslint",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{ts,tsx,js,jsx,json}": [
            "eslint"
        ]
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "devDependencies": {
        "eslint": "9.39.2",
        "eslint-config-next": "16.1.1",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-prettier": "5.5.4",
        "husky": "9.1.7",
        "prettier": "3.7.4",
        "typescript-eslint": "8.51.0"
    },
    "packageManager": "pnpm@10.27.0+sha512.72d699da16b1179c14ba9e64dc71c9a40988cbdc65c264cb0e489db7de917f20dcf4d64d8723625f2969ba52d4b7e2a1170682d9ac2a5dcaeaab732b7e16f04a"
}