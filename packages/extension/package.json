{
  "name": "@atproxy/extension",
  "version": "1.0.0",
  "description": "Browser extension for Atproxy",
  "scripts": {
    "build": "npm run build:bg && npm run build:content && npm run build:inject && npm run build:popup && npm run copy-assets",
    "build:bg": "esbuild src/background/index.ts --bundle --format=esm --outfile=dist/background.js --target=es2022",
    "build:content": "esbuild src/content/index.ts --bundle --format=iife --outfile=dist/content.js --target=es2022",
    "build:inject": "esbuild src/inject/index.ts --bundle --format=iife --outfile=dist/inject.js --target=es2022",
    "build:popup": "esbuild src/popup/index.ts --bundle --format=iife --outfile=dist/popup.js --target=es2022",
    "dev": "npm run build -- --watch",
    "copy-assets": "node scripts/copy-assets.js",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/chrome": "0.1.32",
    "@types/node": "25.0.3",
    "esbuild": "0.27.2",
    "typescript": "5.9.3"
  }
}